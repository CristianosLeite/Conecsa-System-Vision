{
  // Pyright/Pylance config. extraPaths makes the editor resolve imports that
  // the runtime resolves dynamically: (1) the generated protobuf stubs in
  // api-gateway/gateway/proto (run scripts/compile-proto.sh once so they
  // exist) — imported flat like `import training_pb2`; (2) the `conecsa_shm`,
  // `conecsa_common` and `agent` packages under os-base/ — the os-base
  // Dockerfile installs them as top-level packages, so adding os-base/ to the
  // path lets the editor resolve them by name with real types; (3) the three
  // service roots so their top-level packages (`api`, `service`, `gateway`)
  // resolve for both service code and the tests/ that import them — the
  // runtime adds these via each pyproject's pytest `pythonpath`.
  "pythonVersion": "3.10",
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "api-gateway/gateway/proto",
    "os-base",
    "inference-service",
    "training-service",
    "api-gateway"
  ],

  // Not walked at all. yocto/ is the vendored Poky tree — tens of thousands
  // of Python files that make a repo-root `pyright` run exhaust the node heap
  // and die.
  "exclude": [
    "**/.*",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/target",
    "yocto"
  ],

  // Analyzed (so imports keep their real types) but diagnostics suppressed.
  // The *_pb2*.py files are protoc output regenerated by
  // scripts/compile-proto.sh — their `grpc.experimental` block is not
  // declared by the grpcio stubs, and we do not hand-edit generated code.
  "ignore": [
    "api-gateway/gateway/proto",
    "inference-service/api/proto",
    "training-service/service/proto"
  ]
}
