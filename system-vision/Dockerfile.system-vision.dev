# ============================================================================
# DEV system-vision image (x86_64).
#
# Same build-WASM-then-serve-with-nginx pipeline as Dockerfile.system-vision, but pulls
# the x86_64 Tailwind binary (the production image fetches the aarch64 one for the
# Jetson). The frontend is built (not bind-mounted) — per the dev choice to serve
# it like production; rebuild the image to pick up frontend changes.
# ============================================================================

# Stage 1: Build WASM frontend with Trunk
FROM rust:1.98-slim AS frontend-builder

WORKDIR /app

# Fetch apt packages over https only — some networks drop plain http, which
# would fail the build. The rust base ships ca-certificates, so TLS already
# works here; the grep guard fails the build if a base-image update ever
# reintroduces an http source this sed does not catch.
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources \
    && ! grep -rq 'http://' /etc/apt/sources.list.d/

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    build-essential \
    curl \
    protobuf-compiler \
    libprotobuf-dev \
    binaryen \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add wasm32-unknown-unknown

# Prebuilt trunk, pinned as in Dockerfile.system-vision.
ARG TRUNK_VERSION=0.21.14
ARG TRUNK_SHA256_X86_64=f2b4680cd239693a646a2795e4633c625328d7b2a044fbe749fa3a2fe9e7036b
ARG TRUNK_SHA256_AARCH64=b1d8e60e454f7fc182d9a4d95d1506ffbae947d8ba90f8f6f02da93b60f980f9
RUN set -eu; arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) sum="$TRUNK_SHA256_X86_64" ;; \
        aarch64) sum="$TRUNK_SHA256_AARCH64" ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/trunk.tar.gz \
        "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-${arch}-unknown-linux-gnu.tar.gz"; \
    echo "$sum  /tmp/trunk.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/trunk.tar.gz -C /usr/local/bin trunk; \
    rm -f /tmp/trunk.tar.gz; \
    trunk --version

COPY Cargo.toml Cargo.lock /app/

COPY system-vision/ ./system-vision/

# Shared design system (Tailwind input) used by system-vision + hub-vision
COPY styles/ ./styles/

COPY proto/ ./proto/

# Shared translation catalogs (read by build.rs via ../i18n/system-vision)
COPY i18n/ ./i18n/

# Tailwind CSS v4 standalone binary, pinned by version and per-architecture
# SHA256 (scripts/tailwind.pin is the source of truth; `bump-tailwind-version`).
ARG TAILWIND_VERSION=4.3.3
ARG TAILWIND_SHA256_X86_64=dc61b3ac6b8c9ca874c0cc4c57b2409791a64c5540404ca5f5367360babc313a
ARG TAILWIND_SHA256_AARCH64=55fd0b241214eff3de1e8ee4f22796662f2d2e7a49bcfca7477cfd0bac398195
RUN set -eu; arch="$(uname -m)"; \
    case "$arch" in \
        x86_64) asset=tailwindcss-linux-x64; sum="$TAILWIND_SHA256_X86_64" ;; \
        aarch64) asset=tailwindcss-linux-arm64; sum="$TAILWIND_SHA256_AARCH64" ;; \
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/tailwindcss \
        "https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWIND_VERSION}/${asset}"; \
    echo "$sum  /usr/local/bin/tailwindcss" | sha256sum -c -; \
    chmod +x /usr/local/bin/tailwindcss; \
    tailwindcss --help | head -1

RUN cd system-vision && tailwindcss -i ../styles/input.css -o ./styles.css --minify

# Build WASM with Trunk — run from system-vision/ so cargo finds its Cargo.toml
# directly, avoiding the virtual workspace root. dist goes back to /app/dist/.
RUN cd system-vision && trunk build --release --dist ../dist

# Stage 2: Serve with Nginx
FROM nginx:alpine-slim

# openssl mints the temporary self-signed cert for the enrollment TLS block.
RUN apk add --no-cache openssl

COPY --from=frontend-builder /app/dist/ /usr/share/nginx/html/
COPY system-vision/config/nginx.conf /etc/nginx/conf.d/default.conf
COPY system-vision/config/maps.conf /etc/nginx/conf.d/maps.conf
COPY system-vision/config/nginx-enroll.conf /etc/nginx/conecsa/enroll.conf
COPY system-vision/config/nginx-enforcing.conf /etc/nginx/conecsa/enforcing.conf
COPY system-vision/config/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 443

CMD ["/entrypoint.sh"]
