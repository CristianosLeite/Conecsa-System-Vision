[Match]
Name=eth* en*

[Network]
DHCP=yes
LinkLocalAddressing=ipv4

[DHCPv4]
UseDomains=yes
# Don't accept DHCP-pushed NTP servers: a site LAN can advertise an
# unreachable one (option 42), which keeps systemd-timesyncd from ever
# falling back to the public servers pinned in timesyncd.conf.d.
UseNTP=no

[DHCPv6]
UseNTP=no

[IPv6AcceptRA]
UseNTP=no
