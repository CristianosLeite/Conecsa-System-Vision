# Pinned face recognition models (shell-sourceable; mirrored as ARGs in
# inference-service/Dockerfile.inference-service). Fetched by
# scripts/fetch-face-models.sh into inference-service/assets/face/ and
# verified by SHA256 at image build.
#
# YuNet face detector — MIT, (c) Shiqi Yu and contributors
#   https://github.com/opencv/opencv_zoo/tree/main/models/face_detection_yunet
# SFace face recognition (embeddings) — Apache-2.0
#   https://github.com/opencv/opencv_zoo/tree/main/models/face_recognition_sface
#
# The URLs serve Git LFS media; the checksums are what pins the content.
FACE_MODELS_BASE_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/main/models
FACE_DETECTOR_FILE=face_detection_yunet_2023mar.onnx
FACE_DETECTOR_PATH=face_detection_yunet/${FACE_DETECTOR_FILE}
FACE_DETECTOR_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
FACE_EMBEDDER_FILE=face_recognition_sface_2021dec.onnx
FACE_EMBEDDER_PATH=face_recognition_sface/${FACE_EMBEDDER_FILE}
FACE_EMBEDDER_SHA256=0ba9fbfa01b5270c96627c4ef784da859931e02f04419c829e83484087c34e79
