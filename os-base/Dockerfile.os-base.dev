# ============================================================================
# DEV base image for the Conecsa stack on x86_64 + NVIDIA GPU.
#
# Mirrors os-base/Dockerfile.os-base (the Jetson/aarch64 production base) but for local
# development on an x86_64 workstation with an NVIDIA GPU. The differences:
#
#   - GPU wheels come from PyPI (torch / torchvision / onnxruntime-gpu /
#     tensorrt-cu12 / pycuda) instead of the aarch64 jetson-ai-lab index.
#   - No `os-base` hardware agent layer (wpa_supplicant / jeepney / Jetson.GPIO)
#     — the `os-base` service runs only as the shared base + named-volume owner
#     in docker-compose.dev.yml; the agent runs only on the Jetson.
#   - No Tegra LD_LIBRARY_PATH; the standard CUDA paths are enough off-device.
#
# Used as `FROM base` by the *.dev service images (the dev compose maps
# base=service:os-base via additional_contexts, exactly like production).
# ============================================================================

FROM nvidia/cuda:12.6.0-devel-ubuntu22.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/Sao_Paulo

# Fetch apt packages over https only — some networks drop plain http, which
# would fail the build. The CUDA base ships ca-certificates, so TLS already
# works here; the grep guard fails the build if a base-image update ever
# reintroduces an http source this sed does not catch.
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list \
    && ! grep -rq 'http://' /etc/apt/sources.list /etc/apt/sources.list.d/

RUN apt-get update && apt-get install -y --no-install-recommends --allow-change-held-packages \
        python3.10 \
        python3.10-dev \
        python3.10-venv \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        libopenblas-dev \
        build-essential \
        gcc \
        g++ \
        make \
        wget \
        curl \
        ca-certificates \
        git \
        libjpeg-dev \
        libpng-dev \
        libtiff-dev \
        libjemalloc2 \
        libnuma1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    curl -fsSL -o /tmp/get-pip.py https://raw.githubusercontent.com/pypa/get-pip/f6f644156f23dfe9acc06e7b9ca75eee311f2e37/public/get-pip.py && \
    echo "fb24e693bab954209a063d90953621412ccad4a500905a726286e038f508ddf6  /tmp/get-pip.py" | sha256sum -c - && \
    python3.10 /tmp/get-pip.py && rm /tmp/get-pip.py && \
    python3 -m pip install --no-cache-dir --upgrade pip --root-user-action=ignore

ENV CUDA_HOME=/usr/local/cuda-12.6
ENV CUDA_PATH=/usr/local/cuda-12.6
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
ENV CUDA_MODULE_LOADING=LAZY
ENV PYTHONUNBUFFERED=1

# Dependencies follow scripts/init.sh, not the Jetson wheels: the shared ML
# stack from requirements-common.txt, then `tensorrt-cu12` + `pycuda` + `onnx`
# from PyPI (init.sh's `--gpu` step), then numpy forced back to 1.26.4 for the
# pycuda/tensorrt ABI.
#
# tensorrt-cu12 and pycuda are pinned to the Jetson base versions (10.3.0,
# 2024.1): newer TensorRT 10.x removed the `EXPLICIT_BATCH` flag the engine
# builder uses. torch arrives transitively via ultralytics as a CPU build; it
# only runs the .pt→.onnx conversion.
COPY os-base/requirements-common.txt /app/
RUN pip install --no-cache-dir --root-user-action=ignore \
        -r /app/requirements-common.txt && \
    pip install --no-cache-dir --root-user-action=ignore \
        tensorrt-cu12==10.3.0 pycuda==2024.1 onnx==1.22.0 && \
    pip install --no-cache-dir --force-reinstall --root-user-action=ignore \
        numpy==1.26.4

# Shared data directories owned by this container; mounted as named volumes
# by the services that consume them.
RUN mkdir -p /data/models /data/runs /data/training

# Shared SHM ring helpers — importable as `conecsa_shm` by every FROM-base
# service. Kept on the default import path for parity with production; the dev
# services also see the live os-base/conecsa_shm via the bind-mounted /workspace.
COPY os-base/conecsa_shm/ /usr/local/lib/python3.10/dist-packages/conecsa_shm/

# Third-party notices, at the same path as the production base image.
COPY os-base/THIRD-PARTY-NOTICES.md /usr/share/doc/conecsa/THIRD-PARTY-NOTICES-os-base.md

# Keep the container alive so it stays the canonical owner of the volumes when
# used as a plain base image (the dev compose does not run the hardware agent).
CMD ["tail", "-f", "/dev/null"]
